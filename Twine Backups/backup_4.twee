:: Turn Left {"position":"900,1200","size":"100,100"}
{
(set: $health = $health - $bleedRate)
(set: $progress = $progress + 2)
(if: (random:0,100) < $infectionChance)[
	You feel an infection setting in on one of your injuries... <br/>
    (set: $health = $health - 5)
]
(if: $seeMetrics)[
	HP: $health <br/>
    Bleed Rate: $bleedRate <br/>
    Attack Strength: $attack <br/>
    Mobility: $mobility <br/>
]
You follow the hallway intersection to the left... <br/>
(if: $health < 1)[
	You have lost too much blood. The world begins to grow faint as you feel a deep hunger grow... <br/>
    [[Game Over]]
] (else-if: $progress > $finalPval - 1)[
	You see the exit up ahead. You can finally make your escape! <br/>
    [[Exit the Building]] <br/>
    [[Enter a Nearby Room]] 
]  (else-if: (random: 0,100) > $karma)[
	There are zombies in the hallway! They smell you and begin to come after you. <br/>
    <div class="mainImages">
<img height = 300px width = 300px src = "https://cdn.pixabay.com/photo/2020/10/10/10/40/halloween-5642706_640.png" />
</div>
	[[Fight Past Them]] <br/>
	[[Flee]]
](else-if: (random:0,100) < $prostheticChance)[
	You begin to feel faint and nauseous... <br/>
    There is an examination room nearby <br/>
    [[Enter Examination Room]] <br/>
    [[Lie Down and Rest For a Bit (I don't think you will survive this)->Game Over]] 
] (else:)[
<div class="mainImages">
<img height = 300px width = 300px src = "https://images.unsplash.com/photo-1572297870735-065d402f7b29?fm=jpg&q=60&w=1200&auto=format&fit=crop" />
</div>
	(if: (random:0,100) < 33)[
    	You approach an intersection of hallways <br/>
        [[Turn Left]] <br/>
        [[Turn Right]] <br/>
 	]
    [[ Continue Straight]]  <br/>
    [[Enter a Nearby Room]] <br/>
    (if: (random:0,100) < $karma / 2)[
    	There is also a stairwell to go down a few floors <br/>
        [[Go Down]]
    ]
]
}


