:: Use the Supplies on Yourself {"position":"500,1250","size":"100,100"}
{
(set: $bleedRate = (max:0, $bleedRate - 3))
(set: $karma = (max:0, $karma - 15))
(set: $health = (min: 100, $health + 5))
(set: $health = $health - $bleedRate)
(set: $progress = $progress + 2)

(if: $seeMetrics)[
	HP: $health <br/>
    Bleed Rate: $bleedRate <br/>
    Attack Strength: $attack <br/>
    Mobility: $mobility <br/>
]
(if: $health < 1)[
	You have lost too much blood. The world begins to grow faint as you feel a deep hunger grow... <br/>
    [[Game Over]]
] (else:)[
	You use the supplies for yourself to slow your bleeding while the patient grows progressively weaker.. <br/>
    (if: (random:0,100) < 50)[
    	[[Return to The Hallway and Continue ->Enter the Hallway]] 
    ](else:)[
    	[[Return to The Hallway and Continue -> Continue Straight]] 
    ]
]
}


:: StoryStylesheet [stylesheet]
@import url('https://fonts.googleapis.com/css2?family=Audiowide&family=Felipa&display=swap');

tw-passage {
  font-family: Audiowide;
  font: white;
  background : #051a02;
}
.smallCap {
	font-size: 0.5em;
}
.centCap {
  text-align: center;
}
.photos {
  	display: flex;
	margin-bottom: 5px;
  	padding: 5px;
  	justify-content: flex-end;
}
.mainImages {
	display: flex;
  	justify-content: center;
}