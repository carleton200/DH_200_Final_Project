:: StoryStylesheet [stylesheet]
@import url('https://fonts.googleapis.com/css2?family=Audiowide&family=Felipa&display=swap');

tw-passage {
  font-family: Audiowide;
  font: white;
  background : #454545;
  
}

.smallCap {
	font-size: 0.5em;
}
.centCap {
  text-align: center;
}
.photos {
  	display: flex;
	margin-bottom: 5px;
  	padding: 5px;
  	justify-content: flex-end;
}
.mainImages {
	display: flex;
